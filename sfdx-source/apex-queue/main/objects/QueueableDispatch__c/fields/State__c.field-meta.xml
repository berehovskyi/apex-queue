<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>State__c</fullName>
    <description>Lifecycle state for this ephemeral queueable dispatch handoff.</description>
    <inlineHelpText>Tracks WAITING, ACTIVE, COMPLETED, or FAILED dispatcher handoff state, not final job execution outcome.</inlineHelpText>
    <label>State</label>
    <required>true</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>true</sorted>
            <value>
                <fullName>ACTIVE</fullName>
                <default>false</default>
                <label>Active</label>
            </value>
            <value>
                <fullName>COMPLETED</fullName>
                <default>false</default>
                <label>Completed</label>
            </value>
            <value>
                <fullName>FAILED</fullName>
                <default>false</default>
                <label>Failed</label>
            </value>
            <value>
                <fullName>WAITING</fullName>
                <default>true</default>
                <label>Waiting</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
