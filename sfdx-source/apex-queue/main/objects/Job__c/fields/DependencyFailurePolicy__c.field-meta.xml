<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DependencyFailurePolicy__c</fullName>
    <description>Controls how this child job affects its parent when the child fails.</description>
    <inlineHelpText>Parent dependency handling when this child job fails.</inlineHelpText>
    <label>Dependency Failure Policy</label>
    <required>true</required>
    <trackHistory>true</trackHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>true</sorted>
            <value>
                <fullName>CONTINUE_PARENT</fullName>
                <default>false</default>
                <label>Continue Parent</label>
            </value>
            <value>
                <fullName>DEFAULT</fullName>
                <default>true</default>
                <label>Default</label>
            </value>
            <value>
                <fullName>FAIL_PARENT</fullName>
                <default>false</default>
                <label>Fail Parent</label>
            </value>
            <value>
                <fullName>IGNORE_DEPENDENCY</fullName>
                <default>false</default>
                <label>Ignore Dependency</label>
            </value>
            <value>
                <fullName>REMOVE_DEPENDENCY</fullName>
                <default>false</default>
                <label>Remove Dependency</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
