<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ExecutionMode__c</fullName>
    <defaultValue>&quot;WORKER&quot;</defaultValue>
    <description>Required execution lane. WORKER uses the durable batch worker. QUEUEABLE_SERIAL and QUEUEABLE_CONCURRENT use isolated queueable transport. INVOCABLE uses Flow Scheduled Path handoff.</description>
    <inlineHelpText>WORKER is the default. Queueable modes use QueueableDispatch__c. INVOCABLE is isolated from worker and queueable runtime ownership.</inlineHelpText>
    <label>Execution Mode</label>
    <required>true</required>
    <trackHistory>true</trackHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>true</sorted>
            <value>
                <fullName>INVOCABLE</fullName>
                <default>false</default>
                <label>Invocable</label>
            </value>
            <value>
                <fullName>QUEUEABLE_CONCURRENT</fullName>
                <default>false</default>
                <label>Queueable Concurrent</label>
            </value>
            <value>
                <fullName>QUEUEABLE_SERIAL</fullName>
                <default>false</default>
                <label>Queueable Serial</label>
            </value>
            <value>
                <fullName>WORKER</fullName>
                <default>true</default>
                <label>Worker</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
